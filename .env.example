# Resend (solo servidor, sin prefijo NEXT_PUBLIC_). Copia este archivo a .env.local.
RESEND_API_KEY=
# En desarrollo puedes usar onboarding@resend.dev, que solo entrega al correo
# de la cuenta de Resend. Para producción hace falta un dominio verificado.
RESEND_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Supabase. URL y clave publicable son públicas (protegidas por RLS).
# https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo para el CLI (supabase link). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_DB_PASSWORD=
